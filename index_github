<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>نظام تسعيرة التوصيل والخريطة وقائمة الأصناف</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    :root {
      --bg: #f1f5f9;
      --surface: #ffffff;
      --surface-rgb: 255, 255, 255;
      --card-alpha: 0.72;
      --card-blur: 14px;
      --dark-pill: #0f172a;
      --accent-color: #0f172a;
      --accent-text: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --border-alpha: 0.55;
      --green: #10b981;
      --green-border: #34d399;
      --shadow-sm: 0 8px 24px rgba(15, 23, 42, 0.08);
      --radius-lg: 18px;
      --bg-image: none;
      --bg-overlay: rgba(241, 245, 249, 0.45);
      --bg-size: cover;
      --bg-pos: center center;
      --bg-repeat: no-repeat;
      --bg-brightness: 100%;
      --bg-contrast: 100%;
      --card-bg-override: "";
      --inner-box-bg: rgba(248, 250, 252, 0.85);
      --inner-box-border: #e2e8f0;
      --tab-bg-override: "";
    }

    body[data-mode="dark"] {
      --bg: #0b1120;
      --surface: #1e293b;
      --surface-rgb: 15, 23, 42;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border: #334155;
      --shadow-sm: 0 8px 28px rgba(0, 0, 0, 0.36);
      --bg-overlay: rgba(11, 17, 32, 0.55);
      --inner-box-bg: rgba(15, 23, 42, 0.72);
      --inner-box-border: rgba(148, 163, 184, 0.25);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Cairo', sans-serif;
    }

    body {
      background-color: var(--bg);
      color: var(--text-main);
      min-height: 100vh;
      padding: 18px 16px 75px;
      position: relative;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -2;
      pointer-events: none;
      background-image: var(--bg-image);
      background-size: var(--bg-size);
      background-position: var(--bg-pos);
      background-repeat: var(--bg-repeat);
      filter: brightness(var(--bg-brightness)) contrast(var(--bg-contrast));
      transition: filter 0.15s ease;
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background: var(--bg-overlay);
      transition: background 0.15s ease;
    }

    /* Glassmorphic surfaces for cards, search bar, and chips */
    .area-card,
    .search-wrapper,
    .empty-state,
    .map-shell {
      background: var(--card-bg-override, rgba(var(--surface-rgb), var(--card-alpha))) !important;
      backdrop-filter: blur(var(--card-blur)) saturate(150%);
      -webkit-backdrop-filter: blur(var(--card-blur)) saturate(150%);
      border: 1.5px solid rgba(255, 255, 255, var(--border-alpha)) !important;
      box-shadow: var(--shadow-sm);
    }

    body[data-mode="dark"] .area-card,
    body[data-mode="dark"] .search-wrapper,
    body[data-mode="dark"] .empty-state,
    body[data-mode="dark"] .map-shell {
      border-color: rgba(148, 163, 184, 0.22) !important;
    }

    .area-card.recommended {
      border-color: var(--green-border) !important;
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.16);
    }

    .chip,
    .sync-status-pill {
      background: rgba(var(--surface-rgb), calc(var(--card-alpha) * 0.92 + 0.08));
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .main-tabs {
      background: var(--tab-bg-override, rgba(var(--surface-rgb), 0.65));
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(148, 163, 184, 0.25);
    }

    .item-contents-box {
      background: var(--inner-box-bg);
      border-color: var(--inner-box-border);
    }

    .main-tab-btn.active,
    .chip.active,
    .price-box {
      background: var(--accent-color) !important;
      border-color: var(--accent-color) !important;
      color: var(--accent-text) !important;
    }

    .price-currency,
    .chip.active .chip-count {
      color: var(--accent-text) !important;
      opacity: 0.9;
    }

    body[data-mode="dark"] .main-tab-btn:not(.active) {
      color: #cbd5e1;
    }
    body[data-mode="dark"] .main-tab-btn:not(.active):hover {
      color: #ffffff;
    }
    body[data-mode="dark"] .chip:not(.active) {
      color: #e2e8f0;
      border-color: rgba(148, 163, 184, 0.25);
    }
    body[data-mode="dark"] .area-name,
    body[data-mode="dark"] .modal-header h2,
    body[data-mode="dark"] .form-label,
    body[data-mode="dark"] .manage-meta {
      color: #f8fafc;
    }
    body[data-mode="dark"] .branch-pill,
    body[data-mode="dark"] .item-contents-box,
    body[data-mode="dark"] .help-note,
    body[data-mode="dark"] .esc-btn,
    body[data-mode="dark"] .copy-btn,
    body[data-mode="dark"] .sync-status-pill {
      background: rgba(15, 23, 42, 0.72);
      border-color: rgba(148, 163, 184, 0.25);
      color: #e2e8f0;
    }
    body[data-mode="dark"] .ingredient-tag {
      background: rgba(30, 41, 59, 0.85);
      border-color: #475569;
      color: #f1f5f9;
    }
    body[data-mode="dark"] .item-notes-text {
      color: #cbd5e1;
    }
    body[data-mode="dark"] .modal {
      background: #1e293b;
      color: #f8fafc;
      border: 1px solid #334155;
    }
    body[data-mode="dark"] .form-control {
      background: #0f172a;
      border-color: #334155;
      color: #f8fafc;
    }
    body[data-mode="dark"] .card-bottom,
    body[data-mode="dark"] .modal-header,
    body[data-mode="dark"] .manage-row {
      border-color: #334155;
    }
    body[data-mode="dark"] .count-badge {
      background: #334155;
      color: #f8fafc;
    }
    body[data-mode="dark"] .info-strip,
    body[data-mode="dark"] .count-summary {
      color: #e2e8f0;
    }

    .btn-appearance-top {
      background: #7c3aed;
      color: #ffffff;
    }

    .mode-toggle-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .mode-toggle-btn {
      border: 2px solid var(--border);
      background: var(--surface);
      color: var(--text-main);
      border-radius: 12px;
      padding: 10px 12px;
      font-size: 0.88rem;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      transition: all 0.15s;
    }

    .mode-toggle-btn.active {
      border-color: #7c3aed;
      background: rgba(124, 58, 237, 0.12);
    }

    .color-picker-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .color-wheel-input {
      width: 54px;
      height: 44px;
      padding: 2px;
      border: 1.5px solid #cbd5e1;
      border-radius: 10px;
      cursor: pointer;
      background: transparent;
      flex-shrink: 0;
    }

    .preset-dots {
      display: flex;
      align-items: center;
      gap: 7px;
      flex-wrap: wrap;
    }

    .preset-dot-btn {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: 2px solid #ffffff;
      box-shadow: 0 0 0 1.5px #cbd5e1;
      cursor: pointer;
      transition: transform 0.12s;
    }

    .preset-dot-btn:hover {
      transform: scale(1.12);
    }

    .grid-2-cols {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    @media (max-width: 520px) {
      .grid-2-cols {
        grid-template-columns: 1fr;
      }
    }

    .bg-preview-box {
      margin-top: 8px;
      height: 120px;
      border-radius: 12px;
      border: 1.5px dashed #cbd5e1;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #64748b;
      font-size: 0.8rem;
      font-weight: 700;
      overflow: hidden;
      position: relative;
    }

    /* ==================== MAP & TRANSPARENT GLASS CARDS ==================== */
    .map-shell {
      border-radius: 20px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .map-top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .map-legend {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      font-size: 0.78rem;
      font-weight: 800;
    }

    .map-legend-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(var(--surface-rgb), 0.78);
      border: 1px solid rgba(148, 163, 184, 0.28);
    }

    .map-canvas-wrap {
      position: relative;
      height: 620px;
      min-height: 440px;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(148, 163, 184, 0.32);
    }

    @media (max-width: 760px) {
      .map-canvas-wrap {
        height: 520px;
      }
    }

    #deliveryMap {
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .glass-marker-icon {
      background: transparent !important;
      border: none !important;
    }

    .glass-map-card {
      position: relative;
      width: max-content;
      max-width: 225px;
      transform: translate(-50%, -100%);
      background: rgba(var(--surface-rgb), 0.68);
      backdrop-filter: blur(12px) saturate(160%);
      -webkit-backdrop-filter: blur(12px) saturate(160%);
      border: 1.5px solid rgba(255, 255, 255, 0.65);
      border-right: 4px solid var(--card-branch-color, var(--accent-color));
      border-radius: 14px;
      padding: 8px 11px;
      box-shadow: 0 10px 26px rgba(15, 23, 42, 0.18);
      color: var(--text-main);
      cursor: pointer;
      transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
                  box-shadow 0.2s ease,
                  border-color 0.2s ease,
                  background-color 0.2s ease;
      user-select: none;
    }

    body[data-mode="dark"] .glass-map-card {
      background: rgba(15, 23, 42, 0.72);
      border-color: rgba(148, 163, 184, 0.32);
      border-right-color: var(--card-branch-color, var(--accent-color));
      color: #f8fafc;
    }

    .glass-map-card:hover {
      transform: translate(-50%, -104%) scale(1.04);
      z-index: 50;
      box-shadow: 0 14px 32px rgba(15, 23, 42, 0.28);
    }

    @keyframes cardPulseGlow {
      0%, 100% {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7), 0 14px 34px rgba(15, 23, 42, 0.35);
      }
      50% {
        box-shadow: 0 0 0 10px rgba(16, 185, 129, 0), 0 18px 40px rgba(16, 185, 129, 0.45);
      }
    }

    .glass-map-card.highlighted {
      transform: translate(-50%, -108%) scale(1.1);
      background: rgba(var(--surface-rgb), 0.92);
      border-color: #10b981 !important;
      border-right-width: 5px;
      animation: cardPulseGlow 1.5s ease-in-out infinite;
      z-index: 999 !important;
    }

    .glass-card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .glass-card-title {
      font-size: 0.84rem;
      font-weight: 900;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 125px;
    }

    .glass-card-price {
      background: var(--card-branch-color, var(--accent-color));
      color: #ffffff;
      font-size: 0.76rem;
      font-weight: 900;
      padding: 2px 7px;
      border-radius: 8px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .glass-card-meta {
      margin-top: 3px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      font-size: 0.7rem;
      font-weight: 800;
      color: var(--text-muted);
    }

    .glass-card-branch {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      white-space: nowrap;
    }

    .glass-card-tag {
      color: #059669;
      font-weight: 800;
      white-space: nowrap;
    }

    .glass-card-pointer {
      position: absolute;
      bottom: -6px;
      left: 50%;
      transform: translateX(-50%) rotate(45deg);
      width: 11px;
      height: 11px;
      background: rgba(var(--surface-rgb), 0.78);
      border-bottom: 1.5px solid rgba(255, 255, 255, 0.65);
      border-right: 1.5px solid rgba(255, 255, 255, 0.65);
    }

    .map-branch-pin {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transform: translate(-50%, -50%);
      background: #0f172a;
      color: #ffffff;
      border: 2px solid #ffffff;
      border-radius: 999px;
      padding: 5px 11px;
      font-size: 0.78rem;
      font-weight: 900;
      white-space: nowrap;
      box-shadow: 0 8px 22px rgba(15, 23, 42, 0.35);
      cursor: pointer;
    }

    .map-pick-banner {
      position: absolute;
      top: 12px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 800;
      background: #059669;
      color: #ffffff;
      padding: 8px 16px;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 800;
      box-shadow: 0 10px 24px rgba(5, 150, 105, 0.35);
      display: none;
      align-items: center;
      gap: 10px;
      white-space: nowrap;
    }

    .map-pick-banner.active {
      display: inline-flex;
    }

    .leaflet-popup-content-wrapper,
    .leaflet-popup-tip {
      background: rgba(var(--surface-rgb), 0.9) !important;
      backdrop-filter: blur(12px);
      color: var(--text-main) !important;
      border: 1px solid rgba(148, 163, 184, 0.3);
      border-radius: 14px !important;
      font-family: 'Cairo', sans-serif !important;
    }

    /* ==================== LUXURY ENTRANCE PRESENTATION & FLUID MOTION ==================== */
    @keyframes splashLogoEntrance {
      0% {
        opacity: 0;
        transform: scale(0.84) translateY(18px);
        filter: blur(10px) brightness(0.8);
      }
      65% {
        opacity: 1;
        transform: scale(1.03) translateY(-4px);
        filter: blur(0px) brightness(1.08);
      }
      100% {
        opacity: 1;
        transform: scale(1) translateY(0);
        filter: blur(0px) brightness(1);
      }
    }

    @keyframes splashAuraPulse {
      0%, 100% {
        transform: scale(0.95);
        opacity: 0.75;
      }
      50% {
        transform: scale(1.08);
        opacity: 1;
      }
    }

    @keyframes splashLightSweep {
      0% {
        transform: translateX(140%) skewX(-22deg);
      }
      100% {
        transform: translateX(-180%) skewX(-22deg);
      }
    }

    @keyframes splashGoldBar {
      0% {
        width: 0%;
      }
      100% {
        width: 100%;
      }
    }

    @keyframes cardCascadeIn {
      0% {
        opacity: 0;
        transform: translateY(20px) scale(0.965);
        filter: blur(4px);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
      }
    }

    @keyframes sectionSlideReveal {
      0% {
        opacity: 0;
        transform: translateY(14px) scale(0.985);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes containerEntrance {
      0% {
        opacity: 0;
        transform: translateY(22px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .splash-presentation {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at 50% 42%, #240b3b 0%, #120520 55%, #07020e 100%);
      transition: opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.75s cubic-bezier(0.22, 1, 0.36, 1),
                  visibility 0.75s;
      overflow: hidden;
      padding: 20px;
    }

    .splash-presentation.hide-splash {
      opacity: 0;
      transform: scale(1.05);
      visibility: hidden;
      pointer-events: none;
    }

    .splash-glow-orb {
      position: absolute;
      width: 440px;
      height: 440px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(168, 85, 247, 0.34) 0%, rgba(234, 179, 8, 0.16) 45%, transparent 72%);
      filter: blur(36px);
      animation: splashAuraPulse 2.4s ease-in-out infinite;
      pointer-events: none;
    }

    .splash-logo-stage {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 2;
      animation: splashLogoEntrance 0.95s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .splash-logo-frame {
      position: relative;
      border-radius: 30px;
      padding: 6px;
      background: linear-gradient(145deg, rgba(250, 204, 21, 0.65), rgba(147, 51, 234, 0.45), rgba(250, 204, 21, 0.25));
      box-shadow: 0 28px 80px rgba(0, 0, 0, 0.75),
                  0 0 48px rgba(147, 51, 234, 0.42),
                  0 0 24px rgba(234, 179, 8, 0.25);
      overflow: hidden;
    }

    .splash-logo-frame::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 60%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 243, 196, 0.32), transparent);
      animation: splashLightSweep 1.55s ease-in-out 0.3s;
      pointer-events: none;
    }

    .splash-logo-img {
      display: block;
      max-height: min(64vh, 430px);
      width: auto;
      max-width: 82vw;
      border-radius: 25px;
      object-fit: contain;
    }

    .splash-gold-loader {
      margin-top: 22px;
      width: 210px;
      height: 4px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.12);
      overflow: hidden;
      box-shadow: 0 0 14px rgba(234, 179, 8, 0.25);
    }

    .splash-gold-loader-fill {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #9333ea, #facc15, #fde047);
      animation: splashGoldBar 1.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .container {
      opacity: 0;
      transform: translateY(18px);
    }

    .container.app-revealed {
      animation: containerEntrance 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .main-tab-btn {
      transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
                  background-color 0.25s ease,
                  color 0.22s ease,
                  box-shadow 0.25s ease;
    }

    .main-tab-btn:active {
      transform: scale(0.96);
    }

    .view-section.section-animating {
      animation: sectionSlideReveal 0.42s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .search-wrapper {
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
                  box-shadow 0.25s ease,
                  border-color 0.25s ease;
    }

    .search-wrapper:focus-within {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(15, 23, 42, 0.12);
      border-color: var(--accent-color) !important;
    }

    .chip {
      transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
                  background-color 0.22s ease,
                  color 0.22s ease,
                  border-color 0.22s ease,
                  box-shadow 0.22s ease;
    }

    .chip:hover {
      transform: translateY(-2px);
    }

    .chip:active {
      transform: scale(0.95);
    }

    .area-card {
      opacity: 0;
      animation: cardCascadeIn 0.46s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: calc(var(--stagger-idx, 0) * 32ms);
      transition: transform 0.26s cubic-bezier(0.22, 1, 0.36, 1),
                  box-shadow 0.26s cubic-bezier(0.22, 1, 0.36, 1),
                  border-color 0.22s ease;
      will-change: transform, opacity;
    }

    .area-card:hover {
      transform: translateY(-4px) scale(1.008);
      box-shadow: 0 14px 32px rgba(15, 23, 42, 0.14);
    }

    .area-card:active {
      transform: translateY(-1px) scale(0.996);
    }

    .price-box {
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .area-card:hover .price-box {
      transform: scale(1.04);
    }

    .copy-btn, .card-edit-btn, .card-del-btn, .btn-m, .admin-toolbar-btn, .esc-btn {
      transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1),
                  background-color 0.18s ease,
                  box-shadow 0.18s ease;
    }

    .copy-btn:active, .card-edit-btn:active, .card-del-btn:active, .btn-m:active, .admin-toolbar-btn:active {
      transform: scale(0.94);
    }

    .modal-backdrop {
      opacity: 0;
      transition: opacity 0.24s ease;
    }

    .modal-backdrop.open {
      opacity: 1;
    }

    .modal-backdrop.open .modal {
      animation: cardCascadeIn 0.34s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .container {
      max-width: 1120px;
      margin: 0 auto;
    }

    .main-tabs-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 14px;
      flex-wrap: wrap;
    }

    .main-tabs {
      display: inline-flex;
      background: #e2e8f0;
      padding: 5px;
      border-radius: 14px;
      gap: 6px;
      box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.06);
      flex-wrap: wrap;
    }

    .main-tab-btn {
      border: none;
      background: transparent;
      color: #475569;
      font-size: 0.95rem;
      font-weight: 800;
      padding: 9px 18px;
      border-radius: 10px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.18s ease;
      white-space: nowrap;
    }

    .main-tab-btn:hover {
      color: #0f172a;
    }

    .main-tab-btn.active {
      background: #0f172a;
      color: #ffffff;
      box-shadow: 0 3px 10px rgba(15, 23, 42, 0.18);
    }

    .tab-pill-count {
      background: rgba(255, 255, 255, 0.16);
      color: inherit;
      font-size: 0.78rem;
      padding: 1px 8px;
      border-radius: 999px;
      font-weight: 800;
    }

    .main-tab-btn:not(.active) .tab-pill-count {
      background: #cbd5e1;
      color: #1e293b;
    }

    .sync-status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 800;
      color: #475569;
      cursor: pointer;
      user-select: none;
    }

    .sync-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10b981;
    }

    .search-wrapper {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: 16px;
      padding: 10px 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 14px;
      flex-wrap: wrap;
    }

    .search-icon {
      color: #64748b;
      font-size: 1.2rem;
      display: flex;
      align-items: center;
    }

    .search-input {
      flex: 1;
      min-width: 180px;
      border: none;
      outline: none;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-main);
      background: transparent;
      padding: 6px 4px;
    }

    .search-input::placeholder {
      color: #94a3b8;
      font-weight: 600;
    }

    .esc-btn {
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      color: #475569;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 5px 10px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.15s;
      white-space: nowrap;
    }

    .esc-btn:hover {
      background: #e2e8f0;
      color: #0f172a;
    }

    .admin-toolbar-btn {
      display: none;
      border: none;
      font-size: 0.8rem;
      font-weight: 800;
      padding: 7px 13px;
      border-radius: 9px;
      cursor: pointer;
      white-space: nowrap;
      align-items: center;
      gap: 5px;
    }

    .admin-toolbar-btn.visible {
      display: inline-flex;
    }

    .btn-add-top {
      background: #059669;
      color: #ffffff;
    }

    .btn-manage-top {
      background: #0f172a;
      color: #ffffff;
    }

    .btn-cloud-top {
      background: #1d4ed8;
      color: #ffffff;
    }

    .filters-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      overflow-x: auto;
      padding-bottom: 12px;
      margin-bottom: 10px;
      scrollbar-width: none;
    }

    .filters-bar::-webkit-scrollbar {
      display: none;
    }

    .chip {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 6px 14px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 0.85rem;
      font-weight: 800;
      color: #1e293b;
      cursor: pointer;
      white-space: nowrap;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
      transition: all 0.15s;
    }

    .chip:hover {
      border-color: #94a3b8;
    }

    .chip.active {
      background: var(--dark-pill);
      color: #ffffff;
      border-color: var(--dark-pill);
    }

    .chip.active .chip-count {
      color: #cbd5e1;
    }

    .chip-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
      flex-shrink: 0;
    }

    .chip-count {
      font-weight: 700;
      color: #64748b;
      font-size: 0.8rem;
    }

    .info-strip {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 16px;
      font-size: 0.85rem;
      color: #64748b;
      font-weight: 700;
    }

    .info-note {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .info-note-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--green);
      display: inline-block;
    }

    .count-summary {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: #475569;
    }

    .count-badge {
      background: #e2e8f0;
      color: #0f172a;
      font-weight: 800;
      font-size: 0.78rem;
      padding: 2px 8px;
      border-radius: 7px;
      cursor: pointer;
      user-select: none;
      transition: transform 0.12s, background-color 0.15s;
    }

    .count-badge:active {
      transform: scale(0.95);
    }

